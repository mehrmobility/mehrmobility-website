    "release:verify-local": "npm run cms:seed-local && npm run check && node scripts/check-mehr-site.mjs"
  },
  "dependencies": {
    "lucide-react": "1.43.0",
    "next": "16.3.4",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "22.20.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.4",
    "typescript": "5.9.3"
  }
}
