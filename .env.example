# Server-only URL of the approved Marketplace Read API.
# Never point this at /api/prototype/sales-basket or expose it with NEXT_PUBLIC_*.
MEHR_MARKETPLACE_READ_API_URL=https://internal-api.example.invalid/customer-marketplace
# Configure either a server-only token or an absolute local token-file path.
MEHR_MARKETPLACE_READ_API_TOKEN=replace-with-a-server-only-service-token
MEHR_MARKETPLACE_READ_API_TOKEN_FILE=
# Required for non-loopback HTTPS upstreams; comma-separated hostnames.
MEHR_MARKETPLACE_READ_API_HOSTS=internal-api.example.invalid

# Private command/read API for customer-owned used-vehicle purchase cases.
MEHR_PURCHASE_WORKFLOW_API_URL=https://internal-api.example.invalid/customer-purchase-workflow
MEHR_PURCHASE_WORKFLOW_API_TOKEN=replace-with-a-server-only-service-token

# Optional public inquiry intake. Leave unset until the receiving service is
# approved, authenticated, audited, rate-limited and durably idempotent.
# No browser-to-internal-database access. See docs/MEHR-EXPERIENCES.fa.md.
MEHR_PUBLIC_INTAKE_API_URL=
MEHR_PUBLIC_INTAKE_API_TOKEN=
MEHR_PUBLIC_SITE_ORIGIN=http://127.0.0.1:3001

# SEO migration settings — keep indexing off in local/staging previews. Enable
# only after the verified production host serves the public /mehr site, all
# legacy redirects pass, and Search Console ownership is confirmed.
MEHR_PUBLIC_ORIGIN=https://mehrmobility.com
MEHR_ALLOW_INDEXING=false

# Admin operator access. Set unique, long values through the host's secret
# manager before production. The local preview defaults only to admin /
# mehr-local-only-change-me when these are absent; never use that in production.
MEHR_ADMIN_USERNAME=
MEHR_ADMIN_PASSWORD=
MEHR_ADMIN_SESSION_SECRET=
# Comma-separated temporary application roles. Production migration must map
# users to cms_user_roles; do not grant SYSTEM_ADMIN by default.
MEHR_ADMIN_ROLES=SYSTEM_ADMIN
# Enables durable CMS writes in production only after backup/audit review.
MEHR_ADMIN_CONTENT_WRITES=false
# Enables catalog source changes in production only after backup/audit review.
MEHR_ADMIN_CATALOG_WRITES=false
